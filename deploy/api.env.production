APP_NAME="Testyco API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.DOMAIN-ANDA.com
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Isi dari cPanel > MySQL Databases
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpuser_testyco_api
DB_USERNAME=cpuser_testyco
DB_PASSWORD=GANTI-PASSWORD-DATABASE

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

MAIL_MAILER=log
RELIABILITY_SMTP_ENABLED=false
SECURITY_EMAIL_RESET_ENABLED=false
WEB_PUBLIC_URL=https://app.DOMAIN-ANDA.com
