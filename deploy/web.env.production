APP_NAME="Testyco"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.DOMAIN-ANDA.com

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Alamat publik API (tanpa /api/v1 dan tanpa garis miring di akhir)
API_BASE_URL=https://api.DOMAIN-ANDA.com

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
